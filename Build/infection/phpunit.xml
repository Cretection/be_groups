<?xml version="1.0" encoding="UTF-8"?>
<!--
    PHPUnit configuration of be_groups for the mutation tests with Infection (CODING_GUIDELINES.md, §13).
    It runs the unit and the functional tests together, as Infection takes one configuration
    from this directory. Both suites pass together in any order.
    Deprecations, notices, warnings and risky tests make the run fail, and every
    test has to declare which code it covers (#[CoversClass]).
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
    backupGlobals="true"
    beStrictAboutOutputDuringTests="true"
    bootstrap="bootstrap.php"
    cacheResult="false"
    colors="true"
    displayDetailsOnTestsThatTriggerDeprecations="true"
    displayDetailsOnTestsThatTriggerErrors="true"
    displayDetailsOnTestsThatTriggerNotices="true"
    displayDetailsOnTestsThatTriggerWarnings="true"
    failOnAllIssues="true"
    failOnDeprecation="true"
    failOnEmptyTestSuite="true"
    failOnNotice="true"
    failOnPhpunitDeprecation="true"
    failOnRisky="true"
    failOnWarning="true"
    requireCoverageMetadata="true"
>
    <php>
        <ini name="display_errors" value="1"/>
        <ini name="memory_limit" value="1G"/>
        <env name="TYPO3_CONTEXT" value="Testing"/>
    </php>
    <source restrictNotices="true" restrictWarnings="true" ignoreIndirectDeprecations="true">
        <include>
            <directory>../../Classes</directory>
            <directory>../../Configuration</directory>
            <file>../../ext_localconf.php</file>
        </include>
    </source>
    <testsuites>
        <testsuite name="Unit">
            <directory>../../Tests/Unit</directory>
        </testsuite>
        <testsuite name="Functional">
            <directory>../../Tests/Functional</directory>
        </testsuite>
    </testsuites>
</phpunit>
